# ==============================================================================
# OmniStream Environment Configuration & TiDB Cloud Secrets Example
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your real '.env' file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# TiDB Cloud Serverless Configuration
# Sign up and create a free Serverless cluster at: https://tidbcloud.com/
# Go to Cluster Overview -> Connect -> Python / PyMySQL
# ------------------------------------------------------------------------------
TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_cluster_prefix.root
TIDB_PASSWORD=your_cluster_password_here
TIDB_DATABASE=omnistream
TIDB_SSL_MODE=REQUIRED

# ------------------------------------------------------------------------------
# Application Defaults (Optional overrides)
# ------------------------------------------------------------------------------
# DEFAULT_MEDIA_TYPE=Video
# DEFAULT_MAX_CONCURRENCY=3
